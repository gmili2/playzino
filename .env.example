# --- MariaDB (docker compose) ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=parcheesi
MARIADB_USER=parcheesi
MARIADB_PASSWORD=change-me
# Port exposé sur la machine hôte (3307 pour ne pas gêner une MariaDB locale).
DB_PORT=3307

# --- Serveur ---
# En local (npm run dev) : la base est joignable via le port exposé.
DATABASE_URL=mysql://parcheesi:change-me@127.0.0.1:3307/parcheesi
# Base de test (créée automatiquement par docker/db-init au premier démarrage).
TEST_DATABASE_URL=mysql://parcheesi:change-me@127.0.0.1:3307/parcheesi_test
# Au moins 32 caractères aléatoires : openssl rand -hex 32
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-min
PORT=4000
APP_PORT=4000
# Origine autorisée du frontend (Vite en dev).
CORS_ORIGIN=http://localhost:5173
# true derrière HTTPS en production.
COOKIE_SECURE=false

# --- Compte administrateur initial (npm run db:seed-admin, ou au démarrage du conteneur) ---
ADMIN_EMAIL=admin@parcheesi.local
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=change-me-admin-123
