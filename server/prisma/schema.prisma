// Parcheesi Online — schéma MariaDB (moteur InnoDB, utf8mb4).
// Le provider "mysql" de Prisma est compatible MariaDB 10.6+.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String     @id @default(cuid()) @db.VarChar(30)
  email           String     @unique @db.VarChar(191)
  username        String     @unique @db.VarChar(32)
  passwordHash    String     @db.VarChar(100)
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  suspendedReason String?    @db.VarChar(500)
  // Incrémenté pour invalider tous les jetons (suspension, changement de mot de passe).
  tokenVersion    Int        @default(0)
  // Compte robot (adversaire d'entraînement) : ne peut pas se connecter, exclu du classement.
  isBot           Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?

  profile             Profile?
  wallet              Wallet?
  hostedRooms         Room[]              @relation("RoomHost")
  roomSeats           RoomPlayer[]
  gameSeats           GamePlayer[]
  wonGames            Game[]              @relation("GameWinner")
  moves               GameMove[]
  auditActions        AuditLog[]          @relation("AuditActor")
  adminTxs            WalletTransaction[] @relation("TxActor")
  deposits            DepositRequest[]    @relation("DepositUser")
  withdrawals         WithdrawalRequest[] @relation("WithdrawalUser")
  reviewedDeposits    DepositRequest[]    @relation("DepositReviewer")
  reviewedWithdrawals WithdrawalRequest[] @relation("WithdrawalReviewer")

  @@index([status])
  @@index([createdAt])
  @@index([isBot])
}

model Profile {
  userId         String   @id @db.VarChar(30)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarColor    String   @default("#2F6BFF") @db.VarChar(7)
  bio            String?  @db.VarChar(280)
  xp             Int      @default(0)
  soundEnabled   Boolean  @default(true)
  invitesEnabled Boolean  @default(true)
  hideOnline     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model Wallet {
  id        String   @id @default(cuid()) @db.VarChar(30)
  userId    String   @unique @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Contrainte CHECK (balance >= 0) ajoutée dans la migration SQL.
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

enum TxType {
  SIGNUP_BONUS
  DAILY_BONUS
  STAKE
  WIN
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REFUND
  WHEEL_SPIN
  WHEEL_PRIZE
}

model WalletTransaction {
  id             String   @id @default(cuid()) @db.VarChar(30)
  walletId       String   @db.VarChar(30)
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type           TxType
  // Montant signé : positif = crédit, négatif = débit.
  amount         Int
  balanceAfter   Int
  reason         String   @db.VarChar(500)
  // Clé unique : rejouer la même opération ne la double jamais.
  idempotencyKey String   @unique @db.VarChar(191)
  roomId         String?  @db.VarChar(30)
  room           Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  gameId         String?  @db.VarChar(30)
  game           Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  actorId        String?  @db.VarChar(30)
  actor          User?    @relation("TxActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@index([gameId])
}

enum GameType {
  PARCHEESI
  CONNECT4
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

model Room {
  id          String         @id @default(cuid()) @db.VarChar(30)
  code        String         @unique @db.VarChar(8)
  name        String         @db.VarChar(40)
  visibility  RoomVisibility
  status      RoomStatus     @default(WAITING)
  maxPlayers  Int            @default(2)
  stake       Int            @default(0)
  turnSeconds Int            @default(30)
  gameType    GameType       @default(PARCHEESI)
  // Partie d'entraînement contre des robots : sans mise, sans XP, hors classement.
  isPractice  Boolean        @default(false)
  // Table ouverte par « partie rapide » : seule celle-ci bascule vers le robot faute d'adversaire.
  quickMatch  Boolean        @default(false)
  hostId      String         @db.VarChar(30)
  host        User           @relation("RoomHost", fields: [hostId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  players      RoomPlayer[]
  games        Game[]
  transactions WalletTransaction[]

  @@index([visibility, status, createdAt])
  @@index([hostId])
}

model RoomPlayer {
  id       String   @id @default(cuid()) @db.VarChar(30)
  roomId   String   @db.VarChar(30)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String   @db.VarChar(30)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  seat     Int
  color    String   @db.VarChar(10)
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId])
}

enum GameStatus {
  ACTIVE
  FINISHED
  ABORTED
}

enum GameEndReason {
  COMPLETED
  FORFEIT
  DISCONNECT
  ADMIN
}

model Game {
  id           String         @id @default(cuid()) @db.VarChar(30)
  roomId       String         @db.VarChar(30)
  room         Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  status       GameStatus     @default(ACTIVE)
  // État complet sérialisé (JSON) du moteur de jeu, réécrit après chaque action.
  state        String         @db.LongText
  stateVersion Int            @default(0)
  winnerId     String?        @db.VarChar(30)
  winner       User?          @relation("GameWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  endReason    GameEndReason?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  players      GamePlayer[]
  moves        GameMove[]
  transactions WalletTransaction[]

  @@index([status, startedAt])
  @@index([roomId])
}

enum GameResult {
  WIN
  LOSS
  DRAW
}

model GamePlayer {
  id     String      @id @default(cuid()) @db.VarChar(30)
  gameId String      @db.VarChar(30)
  game   Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String      @db.VarChar(30)
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  color  String      @db.VarChar(10)
  result GameResult?
  payout Int         @default(0)

  @@unique([gameId, userId])
  @@unique([gameId, color])
  @@index([userId])
}

model GameMove {
  id        String   @id @default(cuid()) @db.VarChar(30)
  gameId    String   @db.VarChar(30)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seq       Int
  userId    String?  @db.VarChar(30)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   @db.VarChar(16)
  payload   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([gameId, seq])
}

model AuditLog {
  id         String   @id @default(cuid()) @db.VarChar(30)
  actorId    String?  @db.VarChar(30)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(64)
  targetType String   @db.VarChar(32)
  targetId   String?  @db.VarChar(30)
  details    String?  @db.Text
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

/// Réglages de la plateforme modifiables par l'administration (ex. botLevel).
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Compte bancaire de l'administration sur lequel les joueurs font leurs virements de dépôt.
model PaymentBank {
  id            String   @id @default(cuid()) @db.VarChar(30)
  name          String   @db.VarChar(60)
  accountHolder String   @db.VarChar(100)
  // RIB marocain : 24 chiffres.
  rib           String   @db.VarChar(24)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deposits DepositRequest[]

  @@index([active])
}

/// Dépôt par virement : crédité seulement quand un admin valide le reçu (1 DH = 1 pièce).
model DepositRequest {
  id             String        @id @default(cuid()) @db.VarChar(30)
  // userId:requestId fourni par le client : un double envoi ne crée qu'une demande.
  clientRef      String        @unique @db.VarChar(80)
  userId         String        @db.VarChar(30)
  user           User          @relation("DepositUser", fields: [userId], references: [id], onDelete: Restrict)
  bankId         String        @db.VarChar(30)
  bank           PaymentBank   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  amount         Int
  // Montant réellement crédité (l'admin peut le corriger d'après le reçu).
  creditedAmount Int?
  receiptFile    String        @db.VarChar(64)
  receiptMime    String        @db.VarChar(32)
  status         PaymentStatus @default(PENDING)
  note           String?       @db.VarChar(500)
  reviewedById   String?       @db.VarChar(30)
  reviewedBy     User?         @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Retrait : le montant est bloqué (débité) dès la demande, remboursé si l'admin la refuse.
model WithdrawalRequest {
  id            String        @id @default(cuid()) @db.VarChar(30)
  clientRef     String        @unique @db.VarChar(80)
  userId        String        @db.VarChar(30)
  user          User          @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Restrict)
  amount        Int
  bankName      String        @db.VarChar(60)
  accountHolder String        @db.VarChar(100)
  rib           String        @db.VarChar(24)
  // APPROVED = virement exécuté par l'admin.
  status        PaymentStatus @default(PENDING)
  note          String?       @db.VarChar(500)
  reviewedById  String?       @db.VarChar(30)
  reviewedBy    User?         @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
